<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BitChord.Windows</RootNamespace>
    <AssemblyName>BitChord</AssemblyName>
    <ApplicationIcon>BitChord.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Single-file publish: pack WebView2Loader.dll into the exe instead of leaving it beside it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <!-- Karaoke: runs the UVR MDX-Net model on any DirectX 12 GPU, CPU otherwise. MIT. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>

  <!-- The shell loads the extension from <exe dir>\extension. Build it first:
       in web/extension: corepack pnpm run build:webview2 -->
  <ItemGroup>
    <None Include="..\..\extension\.output\webview2-mv3\**\*"
          Link="extension\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- The web player is served from <exe dir>\web (https://app.bitchord.example/). Build it first:
       in web: corepack pnpm run build in app/ (needs VITE_PARTY_SERVER_URL, see build.ps1) -->
  <ItemGroup>
    <None Include="..\..\app\dist\**\*"
          Link="web\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- The WebView2 package always references its WPF control, which conflicts with WinForms' WindowsBase (MSB3277). -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
